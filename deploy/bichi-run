#!/bin/bash
# Unico punto con root de bichi work (lo llama el servicio por sudo). El agente corre como hacksllm-work en un
# sandbox de systemd que solo ve su propia sesion: sin /root, /opt, /home ni las sesiones de otros.
#   bichi-run new|clean|stop <sesion>
#   bichi-run agy|opencode <sesion> <modelo> <reanudar|-> < prompt
set -uo pipefail

HOME_DIR=/srv/hacksllm-work
WS=$HOME_DIR/ws
cmd=${1:-} id=${2:-}
[[ $id =~ ^[a-z0-9]{16,40}$ ]] || { echo "sesion invalida" >&2; exit 2; }
dir=$WS/$id
unit=bichi-$id

case $cmd in
  new) exec install -d -o hacksllm-work -g hacksllm -m 2770 "$dir" ;;
  stop) systemctl stop "$unit" 2>/dev/null; exit 0 ;;
  clean) systemctl stop "$unit" 2>/dev/null; rm -rf --one-file-system "$dir"; exit 0 ;;
  agy | opencode) ;;
  *) echo "orden invalida" >&2; exit 2 ;;
esac

model=${3:-} resume=${4:--}
[[ $model =~ ^[a-z0-9./:-]+$ && $resume =~ ^[A-Za-z0-9_-]+$ && -d $dir ]] || { echo "argumentos invalidos" >&2; exit 2; }
prompt=$(cat)
# Lo que dejo el servidor (subidas, paginas recuperadas) pasa a ser del agente; -h: nunca seguir enlaces.
chown -R -h hacksllm-work "$dir"

if [ "$cmd" = agy ]; then
  run=("$HOME_DIR/.local/bin/agy" -p "$prompt" --model "$model" --dangerously-skip-permissions --output-format stream-json)
  [ "$resume" = - ] || run+=(--conversation "$resume")
else
  run=("$HOME_DIR/.local/npm/bin/opencode" run --pure --auto --format json -m "$model")
  [ "$resume" = - ] || run+=(-s "$resume")
  run+=("$prompt")
fi

systemd-run --quiet --pipe --wait --collect --unit="$unit" \
  --uid=hacksllm-work --gid=hacksllm-work \
  -p WorkingDirectory="$dir" -p UMask=0002 \
  -p Environment=HOME="$HOME_DIR" \
  -p Environment=PATH="$HOME_DIR/.local/npm/bin:$HOME_DIR/.local/bin:/usr/local/bin:/usr/bin:/bin" \
  -p MemoryMax=1200M -p MemorySwapMax=512M -p CPUQuota=200% -p TasksMax=256 -p RuntimeMaxSec=1500 \
  -p ProtectSystem=strict -p ProtectHome=yes -p PrivateTmp=yes -p PrivateDevices=yes -p ProtectProc=invisible \
  -p NoNewPrivileges=yes -p RestrictSUIDSGID=yes \
  -p ProtectKernelTunables=yes -p ProtectKernelModules=yes -p ProtectControlGroups=yes \
  -p ReadWritePaths="$HOME_DIR" \
  -p ReadOnlyPaths="$HOME_DIR/.local/bin $HOME_DIR/.local/node $HOME_DIR/.config" \
  -p TemporaryFileSystem="$WS" -p BindPaths="$dir" \
  -p InaccessiblePaths="-/opt -/root -/var/lib -/var/log -/etc/nginx -/etc/letsencrypt -/run/screen -/srv/agyrun-prueba.sh" \
  "${run[@]}" </dev/null
status=$?
chmod -R g+rwX "$dir" 2>/dev/null
exit $status
