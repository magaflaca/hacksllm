[Unit]
Description=hacksllm (OmniRoute gateway)
After=network-online.target
Wants=network-online.target

[Service]
User=hacksllm
Group=hacksllm
WorkingDirectory=/opt/hacksllm/current
EnvironmentFile=/opt/hacksllm/env
Environment=HOME=/opt/hacksllm/home
Environment=PATH=/opt/hacksllm/runtime/bin:/opt/hacksllm/bun/bin:/usr/bin:/bin
ExecStart=/opt/hacksllm/runtime/bin/node dev/run-standalone.mjs
Restart=always
RestartSec=3
MemoryHigh=1600M
MemoryMax=2000M
Nice=5

[Install]
WantedBy=multi-user.target
